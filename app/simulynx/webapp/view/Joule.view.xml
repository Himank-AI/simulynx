<mvc:View controllerName="simulynx.controller.Joule" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" displayBlock="true" height="100%">
  <Page title="Joule" backgroundDesign="Solid" enableScrolling="true">
    <content>
      <VBox class="sapUiSmallMargin">
        <MessageStrip text="Mock Joule adapter. Answers use the committed simulation. SAP Joule is not connected." type="Information" showIcon="true" />
        <Text text="{joule>/intro}" />
        <List items="{joule>/suggestions}" mode="SingleSelectMaster" selectionChange=".onSuggest">
          <StandardListItem title="{joule>text}" />
        </List>
        <TextArea id="question" rows="3" width="100%" placeholder="Why are these personas affected?" />
        <Button text="Ask" press=".onAsk" type="Emphasized" />
        <Panel headerText="Answer" visible="{= !!${joule>/answer} }">
          <Text text="{joule>/answer}" />
        </Panel>
      </VBox>
    </content>
  </Page>
</mvc:View>

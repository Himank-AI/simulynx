<mvc:View controllerName="simulynx.controller.Studio" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core" displayBlock="true" height="100%">
  <Page title="Scenario Studio" backgroundDesign="Solid">
    <content>
      <VBox class="sapUiSmallMargin">
        <Text text="What workforce decision would you like to simulate?" />
        <TextArea id="prompt" value="{studio>/prompt}" rows="3" width="100%" placeholder="Automate 20% of Customer Support over the next 12 months." />
        <HBox>
          <Button text="Interpret" press=".onInterpret" type="Ghost" />
          <Button text="Build Scenario" press=".onBuild" type="Emphasized" enabled="{studio>/canBuild}" class="sapUiTinyMarginBegin" />
          <Button text="Run Simulation" press=".onRun" type="Success" enabled="{studio>/canRun}" class="sapUiTinyMarginBegin" />
        </HBox>
        <MessageStrip text="{studio>/error}" type="Error" visible="{= !!${studio>/error} }" showIcon="true" />
        <Panel headerText="Joule-style interpretation" visible="{studio>/hasDraft}" class="sxFloat">
          <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
            <Label text="Decision" />
            <Text text="{studio>/draft/decision}" />
            <Label text="Department" />
            <Select selectedKey="{studio>/draft/departmentId}" items="{studio>/departments}" change=".onEdit">
              <items>
                <core:Item key="{studio>ID}" text="{studio>name}" />
              </items>
            </Select>
            <Label text="Magnitude" />
            <StepInput value="{studio>/magnitudePercent}" min="0" max="50" step="5" change=".onEdit" />
            <Label text="Timeline (months)" />
            <StepInput value="{studio>/draft/timeHorizonMonths}" min="1" max="60" change=".onEdit" />
            <Label text="Reskilling" />
            <Switch state="{studio>/draft/interventions/reskilling}" change=".onEdit" />
            <Label text="Redeployment" />
            <Switch state="{studio>/draft/interventions/redeployment}" change=".onEdit" />
            <Label text="Role redesign" />
            <Switch state="{studio>/draft/interventions/roleRedesign}" change=".onEdit" />
            <Label text="Hiring backfill" />
            <Switch state="{studio>/draft/interventions/hiring}" change=".onEdit" />
          </f:SimpleForm>
          <Text text="{studio>/notes}" class="sxMuted" />
        </Panel>
        <Text text="Build stores the scenario through ScenarioService. Run asks SimulationService to execute it. The browser does not calculate pathways." class="sxMuted" />
      </VBox>
    </content>
  </Page>
</mvc:View>

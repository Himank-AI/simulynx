<mvc:View controllerName="simulynx.controller.Earth" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" displayBlock="true" height="100%">
  <Page showHeader="true" enableScrolling="false" class="sxStage">
    <customHeader>
      <Toolbar>
        <SearchField width="18rem" placeholder="Search personas..." liveChange=".onSearch" />
        <Select id="cohort" change=".onCohort" />
        <Button icon="sap-icon://zoom-in" press=".onZoomIn" tooltip="Zoom in" />
        <Button icon="sap-icon://zoom-out" press=".onZoomOut" tooltip="Zoom out" />
        <Button text="Reset" press=".onReset" />
      </Toolbar>
    </customHeader>
    <content>
      <VBox id="stage" class="sxStage" height="100%" renderType="Bare">
        <core:HTML id="canvasSlot" sanitizeContent="false" content="&lt;div class='sxStage' style='height:100%;min-height:720px'&gt;&lt;/div&gt;" />
      </VBox>
    </content>
    <footer>
      <OverflowToolbar>
        <Text text="{app>/phase}" />
        <ToolbarSpacer />
        <Text text="{app>/personas} personas" />
        <Text text="{app>/affected} evaluated" />
        <Text text="{app>/highRisk} high transition risk" />
        <Text text="{app>/scenarioName}" />
        <ToolbarSpacer />
        <Button text="Results" press=".onResults" type="Transparent" />
        <Button text="Compare" press=".onCompare" type="Transparent" />
        <Button text="Studio" press=".onStudio" type="Emphasized" />
      </OverflowToolbar>
    </footer>
  </Page>
</mvc:View>

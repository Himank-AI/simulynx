<mvc:View controllerName="simulynx.controller.Personas" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" displayBlock="true" height="100%">
  <Page title="Personas" backgroundDesign="Solid">
    <subHeader>
      <Toolbar>
        <SearchField width="18rem" placeholder="Filter by persona code" liveChange=".onFilter" />
        <Select id="department" change=".onDepartment" />
        <Text text="Synthetic personas. Not employees." class="sxMuted" />
      </Toolbar>
    </subHeader>
    <content>
      <Table id="personas" growing="true" growingThreshold="20" items="{path: 'workforce>/Personas', parameters: { $count: true, $orderby: 'personaCode' }}">
        <columns>
          <Column><Text text="Persona" /></Column>
          <Column><Text text="Role" /></Column>
          <Column><Text text="Department" /></Column>
          <Column><Text text="Stage" /></Column>
          <Column><Text text="Location" /></Column>
          <Column><Text text="Work model" /></Column>
          <Column><Text text="Learning" /></Column>
          <Column><Text text="Mobility" /></Column>
          <Column><Text text="Workload" /></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <Text text="{workforce>personaCode}" />
              <Text text="{workforce>role/name}" />
              <Text text="{workforce>department/name}" />
              <Text text="{workforce>careerStage/name}" />
              <Text text="{workforce>location/name}" />
              <Text text="{workforce>workModel/name}" />
              <Text text="{workforce>learningCapacity}" />
              <Text text="{workforce>mobilityPotential}" />
              <Text text="{workforce>workload}%" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>

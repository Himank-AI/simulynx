{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleDetection": "auto",
    "strict": true,
    "noEmitOnError": true,
    "outDir": "webapp",
    "rootDir": "ts",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "types": []
  },
  "include": ["ts/**/*.ts", "ts/**/*.d.ts"]
}
